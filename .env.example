# --- Flask ---
# Génère une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Keycloak ---
# URL de Keycloak telle qu'elle est joignable DEPUIS le conteneur auth
# (Keycloak >= 17 : pas de suffixe /auth ; Keycloak < 17 : ajouter /auth)
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=monsite
KEYCLOAK_CLIENT_ID=auth-service
KEYCLOAK_CLIENT_SECRET=colle-le-secret-du-client-ici

# --- Site ---
# URL publique du service auth (utilisée pour le callback OIDC)
PUBLIC_URL=https://auth.example.com
# Page où rediriger après login si aucun ?next= n'est fourni
DEFAULT_REDIRECT=https://example.com/
# Domaines vers lesquels on a le droit de rediriger (anti open-redirect), séparés par des virgules
ALLOWED_REDIRECT_DOMAINS=example.com,auth.example.com
# Partage du cookie de session entre sous-domaines (laisser vide en local)
SESSION_COOKIE_DOMAIN=.example.com
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=480
# Mettre à true si derrière un reverse proxy (nginx, traefik, caddy...)
BEHIND_PROXY=true
